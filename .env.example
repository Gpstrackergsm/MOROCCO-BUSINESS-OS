# ========================================================
# MOROCCO BUSINESS OS - ENVIRONMENT CONFIGURATION
# ========================================================

# Node Environment
NODE_ENV=production
PORT=3000

# Railway MySQL Database URL
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@mysql.railway.internal:3306/railway"

# JWT Authentication Secrets
JWT_SECRET="morocco-business-os-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Frontend / API URLs
NEXT_PUBLIC_API_URL="https://your-api-service.up.railway.app"
